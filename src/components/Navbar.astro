---
import Icon from "./Icon.astro"
import { profile } from "../data/profile"

const links = [
  { label: "About", href: "/#about" },
  { label: "Experience", href: "/#experience" },
  { label: "Projects", href: "/#projects" },
  { label: "Contact", href: "/#contact" },
]
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur-md">
  <nav class="container-page flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
      <span
        class="grid size-8 place-items-center rounded-full bg-fg font-mono text-xs text-bg"
        aria-hidden="true"
      >
        RA
      </span>
      <span>{profile.name}</span>
    </a>

    <div class="flex items-center gap-1 md:gap-2">
      <ul class="hidden items-center gap-1 md:flex">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-full px-3 py-2 text-sm text-muted transition-colors hover:text-fg"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <button
        type="button"
        data-theme-toggle
        class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-surface-2 hover:text-fg"
        aria-label="Toggle dark mode"
      >
        <Icon name="moon" size={18} class="dark:hidden" />
        <Icon name="sun" size={18} class="hidden dark:block" />
      </button>

      <a
        href={profile.resume}
        class="btn-ghost hidden !px-4 !py-2 sm:inline-flex"
        download
      >
        <Icon name="download-simple" size={16} />
        Resume
      </a>

      <details class="group relative md:hidden">
        <summary
          class="grid size-9 cursor-pointer list-none place-items-center rounded-full text-muted hover:bg-surface-2 hover:text-fg [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <Icon name="list" size={20} class="group-open:hidden" />
          <Icon name="x" size={20} class="hidden group-open:block" />
        </summary>
        <ul class="shadow-soft absolute top-12 right-0 w-52 rounded-2xl border border-line bg-surface p-2">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block rounded-xl px-3 py-2.5 text-sm hover:bg-surface-2"
              >
                {link.label}
              </a>
            </li>
          ))}
          <li class="sm:hidden">
            <a
              href={profile.resume}
              download
              class="block rounded-xl px-3 py-2.5 text-sm hover:bg-surface-2"
            >
              Resume (PDF)
            </a>
          </li>
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  document
    .querySelectorAll<HTMLDetailsElement>("header details")
    .forEach((menu) => {
      menu
        .querySelectorAll("a")
        .forEach((a) =>
          a.addEventListener("click", () => menu.removeAttribute("open"))
        )
    })
</script>
