---
import { profile } from "../../data/profile"
---

<section class="container-page py-20 md:py-28">
  <h2 class="section-title" data-reveal>
    Tools I ship with
  </h2>
  <p class="mt-4 max-w-[60ch] text-muted" data-reveal>
    A PHP and Laravel core, with Node.js and Go for services and APIs, on SQL
    databases and Linux hosting.
  </p>

  <div class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    {profile.skills.map((group, i) => (
      <div data-reveal style={`--reveal-index: ${i}`}>
        <h3 class="border-t border-fg pt-4 text-sm font-semibold">
          {group.group}
        </h3>
        <ul class="mt-4 flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li class="rounded-full bg-surface-2 px-3 py-1.5 text-sm">
              {item}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
