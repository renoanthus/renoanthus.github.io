---
import { profile } from "../../data/profile"
---

<section id="about" class="border-t border-line bg-surface">
  <div class="container-page grid gap-12 py-20 md:grid-cols-12 md:py-28">
    <div class="md:col-span-7" data-reveal>
      <h2 class="section-title">About me</h2>
      <div class="mt-6 space-y-5 text-base leading-relaxed text-muted md:text-lg">
        {profile.summary.map((paragraph) => (
          <p class="max-w-[65ch]">{paragraph}</p>
        ))}
      </div>
    </div>

    <dl class="grid gap-px self-start overflow-hidden rounded-2xl border border-line bg-line md:col-span-5">
      {profile.facts.map((fact, i) => (
        <div
          class="bg-bg p-6 md:p-7"
          data-reveal
          style={`--reveal-index: ${i + 1}`}
        >
          <dt class="text-sm text-muted">{fact.label}</dt>
          <dd class="mt-1 font-mono text-4xl font-medium tracking-tight">
            {fact.value}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
