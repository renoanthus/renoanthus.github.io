---
import Icon from "../Icon.astro"
import { profile } from "../../data/profile"
---

<section class="container-page py-20 md:py-28">
  <h2 class="section-title" data-reveal>
    Education and recognition
  </h2>

  <div class="mt-12 grid gap-12 md:grid-cols-2">
    <div class="space-y-10" data-reveal>
      <div>
        <h3 class="flex items-center gap-2 text-sm font-semibold">
          <Icon name="graduation-cap" size={18} class="text-accent" />
          Education
        </h3>
        <p class="mt-4 text-lg font-medium">{profile.education.degree}</p>
        <p class="text-muted">{profile.education.school}</p>
        <p class="mt-1 font-mono text-sm text-muted">
          {profile.education.period}, {profile.education.detail}
        </p>
      </div>

      <div>
        <h3 class="flex items-center gap-2 text-sm font-semibold">
          <Icon name="certificate" size={18} class="text-accent" />
          Certification
        </h3>
        {profile.certifications.map((cert) => (
          <div class="mt-4">
            <p class="text-lg font-medium">{cert.name}</p>
            <p class="text-muted">{cert.issuer}</p>
            <p class="mt-1 font-mono text-sm text-muted">{cert.detail}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="space-y-10" data-reveal style="--reveal-index: 1">
      <div>
        <h3 class="flex items-center gap-2 text-sm font-semibold">
          <Icon name="trophy" size={18} class="text-accent" />
          Awards
        </h3>
        <ul class="mt-4 space-y-3">
          {profile.awards.map((award) => (
            <li class="text-lg leading-snug">{award}</li>
          ))}
        </ul>
      </div>

      <div class="grid gap-10 sm:grid-cols-2">
        <div>
          <h3 class="flex items-center gap-2 text-sm font-semibold">
            <Icon name="translate" size={18} class="text-accent" />
            Languages
          </h3>
          <ul class="mt-4 space-y-2">
            {profile.languages.map((lang) => (
              <li>
                <span class="font-medium">{lang.name}</span>
                <span class="block text-sm text-muted">{lang.level}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="flex items-center gap-2 text-sm font-semibold">
            <Icon name="users-three" size={18} class="text-accent" />
            Organizations
          </h3>
          <ul class="mt-4 space-y-2">
            {profile.organizations.map((org) => (
              <li>
                <span class="font-medium">{org.role}</span>
                <span class="block text-sm text-muted">
                  {org.org}, {org.period}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
