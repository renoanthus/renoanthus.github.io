---
import { Image } from "astro:assets"
import Icon from "../Icon.astro"
import portrait from "../../assets/renoanthus.jpeg"
import { profile } from "../../data/profile"
---

<section class="container-page pt-12 pb-20 md:pt-20 md:pb-28">
  <div class="grid items-center gap-12 md:grid-cols-12 md:gap-10">
    <div class="md:col-span-7" data-reveal>
      <p class="font-mono text-xs tracking-[0.16em] text-accent uppercase">
        {profile.role} / {profile.secondaryRole}
      </p>
      <h1 class="mt-5 text-4xl leading-[1.05] font-semibold tracking-tighter text-balance md:text-5xl lg:text-6xl">
        Hi, I'm Reno. {profile.heroHeadline}
      </h1>
      <p class="mt-6 max-w-[52ch] text-lg leading-relaxed text-muted">
        {profile.heroLead}
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#projects" class="btn-primary">
          View projects
          <Icon name="arrow-down" size={16} />
        </a>
        <a href={profile.resume} class="btn-ghost" download>
          <Icon name="download-simple" size={16} />
          Resume
        </a>
      </div>
    </div>

    <div class="md:col-span-5" data-reveal style="--reveal-index: 2">
      <figure class="relative mx-auto max-w-72 md:mr-0 md:ml-auto md:max-w-sm">
        <Image
          src={portrait}
          alt="Reno Anthus riding a bicycle in front of a campus building in Pontianak"
          widths={[400, 640, 800]}
          sizes="(min-width: 768px) 384px, 90vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/5] w-full rounded-2xl object-cover object-[50%_70%]"
        />
        <figcaption class="shadow-soft absolute -bottom-5 left-5 flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2 text-sm">
          <Icon name="map-pin" size={16} class="text-accent" />
          Pontianak, Indonesia
        </figcaption>
      </figure>
    </div>
  </div>
</section>
