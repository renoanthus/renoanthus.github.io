---
import { Image } from "astro:assets"
import Icon from "../Icon.astro"
import { projects, type Project } from "../../data/projects"
import { domainIcons } from "../../lib/domainIcons"

const layout: { slug: string; span: string; tone: string; wide?: boolean }[] = [
  {
    slug: "sehatlink",
    span: "md:col-span-2 lg:col-span-4",
    tone: "bg-accent-soft border-transparent",
  },
  { slug: "mysoedarso", span: "lg:col-span-2", tone: "bg-surface border-line" },
  {
    slug: "api-wa-kanim-sanggau",
    span: "lg:col-span-2",
    tone: "bg-surface-2 border-transparent dotted",
  },
  {
    slug: "reddplus-kalbar",
    span: "md:col-span-2 lg:col-span-4",
    tone: "bg-surface border-line",
    wide: true,
  },
  {
    slug: "rimba",
    span: "md:col-span-2 lg:col-span-4",
    tone: "bg-surface border-line",
    wide: true,
  },
  {
    slug: "robotopo-partner-backend",
    span: "lg:col-span-2",
    tone: "bg-surface-2 border-transparent dotted",
  },
]

const cells = layout.map((cell) => ({
  ...cell,
  project: projects.find((p) => p.slug === cell.slug) as Project,
}))
---

<section id="projects" class="container-page py-20 md:py-28">
  <h2 class="section-title" data-reveal>
    Selected work
  </h2>
  <p class="mt-4 max-w-[60ch] text-muted" data-reveal>
    Production systems for hospitals, government offices, and businesses, mostly
    built backend first.
  </p>

  <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-6">
    {cells.map(({ project, span, tone, wide }, i) => (
      <article
        class:list={[
          "group relative flex flex-col overflow-hidden rounded-2xl border",
          wide && "lg:grid lg:grid-cols-2",
          span,
          tone,
        ]}
        data-reveal
        style={`--reveal-index: ${i % 2}`}
      >
        {project.image && (
          <div
            class:list={[
              "overflow-hidden border-line bg-surface-2",
              wide ? "border-b lg:border-r lg:border-b-0" : "border-b",
            ]}
          >
            <Image
              src={project.image}
              alt={`Screenshot of ${project.title}`}
              widths={[480, 800, 1100]}
              sizes="(min-width: 1024px) 400px, (min-width: 768px) 90vw, 100vw"
              class="aspect-[16/9] h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.02] lg:aspect-auto"
            />
          </div>
        )}
        <div class="flex flex-1 flex-col p-6 md:p-7">
          <div class="flex items-center gap-2 text-sm text-muted">
            <Icon
              name={domainIcons[project.domain]}
              size={18}
              class="text-accent"
            />
            {project.domain}
          </div>
          <h3
            class:list={[
              "mt-4 font-semibold tracking-tight",
              project.slug === "sehatlink" ? "text-2xl md:text-3xl" : "text-xl",
            ]}
          >
            {project.title}
          </h3>
          <p class="mt-1 text-sm text-muted">{project.subtitle}</p>
          <p class="mt-4 max-w-[60ch] leading-relaxed">{project.summary}</p>
          {project.highlight && (
            <p class="mt-3 max-w-[60ch] text-sm leading-relaxed text-muted">
              {project.highlight}
            </p>
          )}
          {(project.stack || project.url) && (
            <div class="mt-auto flex flex-wrap items-center gap-2 pt-6">
              {project.stack?.map((tech) => (
                <span class="rounded-full border border-line px-2.5 py-1 font-mono text-xs text-muted">
                  {tech}
                </span>
              ))}
              {project.url && (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener"
                  class="ml-auto inline-flex items-center gap-1 text-sm font-medium hover:text-accent"
                >
                  Visit
                  <Icon name="arrow-up-right" size={14} />
                </a>
              )}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .dotted {
    background-image: radial-gradient(
      color-mix(in srgb, var(--muted) 28%, transparent) 1px,
      transparent 1px
    );
    background-size: 14px 14px;
  }
</style>
