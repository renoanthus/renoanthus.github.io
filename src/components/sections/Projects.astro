---
import { Image } from "astro:assets"
import Icon from "../Icon.astro"
import { domains, projects } from "../../data/projects"
import { domainIcons } from "../../lib/domainIcons"
import { profile } from "../../data/profile"

const INITIAL = 12
const more = projects
  .filter((p) => !p.featured)
  .sort((a, b) => Number(Boolean(a.image)) - Number(Boolean(b.image)))
const usedDomains = domains.filter((d) => more.some((p) => p.domain === d))
---

<section class="border-t border-line bg-surface">
  <div
    class="container-page py-20 md:py-28"
    data-projects
    data-initial={INITIAL}
  >
    <h2 class="section-title" data-reveal>
      More projects
    </h2>
    <p class="mt-4 max-w-[60ch] text-muted" data-reveal>
      {more.length} more systems across healthcare, government, finance,
      commerce, and operations. Filter by domain.
    </p>

    <div
      class="mt-8 -mx-5 flex gap-2 overflow-x-auto px-5 pb-2 md:mx-0 md:flex-wrap md:px-0"
      role="group"
      aria-label="Filter projects by domain"
    >
      <button
        type="button"
        class="filter-pill"
        data-filter="all"
        aria-pressed="true"
      >
        All <span class="text-muted">{more.length}</span>
      </button>
      {usedDomains.map((domain) => (
        <button
          type="button"
          class="filter-pill"
          data-filter={domain}
          aria-pressed="false"
        >
          {domain}
          <span class="text-muted">
            {more.filter((p) => p.domain === domain).length}
          </span>
        </button>
      ))}
    </div>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {more.map((project, i) => (
        <li
          data-project
          data-domain={project.domain}
          class:list={[i >= INITIAL && "hidden"]}
        >
          <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-bg">
            {project.image && (
              <Image
                src={project.image}
                alt={`Screenshot of ${project.title}`}
                widths={[400, 720]}
                sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
                class="aspect-[16/9] w-full border-b border-line object-cover object-top"
              />
            )}
            <div class="flex flex-1 flex-col p-5">
              <p class="flex items-center gap-1.5 text-xs text-muted">
                <Icon
                  name={domainIcons[project.domain]}
                  size={15}
                  class="text-accent"
                />
                {project.domain}
              </p>
              <h3 class="mt-2 font-semibold tracking-tight">{project.title}</h3>
              <p class="text-sm text-muted">{project.subtitle}</p>
              <p class="mt-3 text-sm leading-relaxed">{project.summary}</p>
              {(project.stack || project.url) && (
                <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-5">
                  {project.stack?.map((tech) => (
                    <span class="rounded-full border border-line px-2 py-0.5 font-mono text-[11px] text-muted">
                      {tech}
                    </span>
                  ))}
                  {project.url && (
                    <a
                      href={project.url}
                      target="_blank"
                      rel="noopener"
                      class="ml-auto inline-flex items-center gap-1 text-sm font-medium hover:text-accent"
                      aria-label={`Visit ${project.title}`}
                    >
                      Visit
                      <Icon name="arrow-up-right" size={14} />
                    </a>
                  )}
                </div>
              )}
            </div>
          </article>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <button type="button" class="btn-ghost" data-show-all>
        Show all {more.length}
      </button>
      <a href={profile.github} target="_blank" rel="noopener" class="btn-ghost">
        <Icon name="github-logo" size={16} />
        GitHub
      </a>
    </div>
  </div>
</section>

<style>
  @reference "../../styles/global.css";

  .filter-pill {
    @apply inline-flex shrink-0 items-center gap-1.5 rounded-full border border-line px-3.5 py-1.5 text-sm whitespace-nowrap transition-colors hover:border-fg;
  }

  .filter-pill[aria-pressed="true"] {
    @apply border-fg bg-fg text-bg;
  }

  .filter-pill[aria-pressed="true"] span {
    @apply text-bg/70;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-projects]").forEach((root) => {
    const initial = Number(root.dataset.initial ?? 12)
    const pills = root.querySelectorAll<HTMLButtonElement>("[data-filter]")
    const items = root.querySelectorAll<HTMLElement>("[data-project]")
    const showAll = root.querySelector<HTMLButtonElement>("[data-show-all]")
    let filter = "all"
    let expanded = false

    const render = () => {
      let visibleIndex = 0
      items.forEach((item) => {
        const matches = filter === "all" || item.dataset.domain === filter
        const withinLimit =
          expanded || filter !== "all" || visibleIndex < initial
        item.classList.toggle("hidden", !(matches && withinLimit))
        if (matches) visibleIndex++
      })
      if (showAll) showAll.hidden = expanded || filter !== "all"
    }

    pills.forEach((pill) =>
      pill.addEventListener("click", () => {
        filter = pill.dataset.filter ?? "all"
        pills.forEach((p) => p.setAttribute("aria-pressed", String(p === pill)))
        render()
      })
    )

    showAll?.addEventListener("click", () => {
      expanded = true
      render()
    })
  })
</script>
